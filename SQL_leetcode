#1378. 使用唯一标识码替换员工ID
SELECT 
  IFNULL(eu.unique_id, null) AS unique_id, //⚠️注意这里 IFNULL 语法使用，如何修改 default value。
  e.name
FROM employees e
LEFT JOIN employeeuni eu 
ON e.id = eu.id;

#1068. 产品销售分析 I
SELECT 
    p.product_name,
    s.year,
    s.price
FROM sales s

JOIN product p 
ON s.product_id = p.product_id

#1581. 进店却未进行交易的顾客
SELECT 
    v.customer_id,
    COUNT(customer_id) AS count_no_trans
FROM visits v

LEFT JOIN transactions t 
ON v.visit_id = t.visit_id

WHERE transaction_id IS NULL
GROUP BY v.customer_id;

#197. 上升的温度
CROSS JOIN 语法！划重点

SELECT w.id
FROM weather w
CROSS JOIN weather w1
ON datediff(w.recordDate, w1.recordDate) = 1
WHERE w.temperature > w1.temperature;

#2356. 每位教师教授的科目数量
SELECT 
    teacher_id,
    COUNT(DISTINCT subject_id) AS cnt 
FROM teacher
GROUP BY teacher_id;   
